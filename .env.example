APP_NAME=WorkZone
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — used for owner/admin password setup invitations.
# With MAIL_MAILER=log or array, WorkZone does not send email and instead
# shows the admin a one-time password setup link in the UI.
# For real delivery use smtp (or ses, postmark, resend, etc.):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=tls
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Content Security Policy (see config/csp.php). Never enables script-src unsafe-eval.
# CSP_REPORT_ONLY=true sends Content-Security-Policy-Report-Only instead of enforcing.
CSP_REPORT_ONLY=false
# Allowed when public/hot exists (Vite HMR). Ignored in production builds.
VITE_DEV_ORIGIN=http://127.0.0.1:5173

# Display timezone for UI / booking wall clocks (storage stays UTC via APP / config timezone).
APP_DISPLAY_TIMEZONE=Asia/Gaza

# Map tiles (Leaflet). OSM public tiles are for light local/demo use only.
# For production, set a tile provider URL + attribution and allow its host in CSP via MAP_TILE_HOST.
MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
MAP_TILE_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>"
MAP_TILE_HOST="https://tile.openstreetmap.org https://a.tile.openstreetmap.org https://b.tile.openstreetmap.org https://c.tile.openstreetmap.org"
MAP_MARKERS_LIMIT=100
MAP_DEFAULT_LAT=31.5017
MAP_DEFAULT_LNG=34.4668
MAP_DEFAULT_ZOOM=11

# Admin security — leave false until every admin has enrolled TOTP.
# When true, admins without setup are redirected to /admin/two-factor/setup (not locked out).
# Emergency unlock: php artisan admin:2fa-reset {email}
ADMIN_2FA_ENFORCED=false
ADMIN_IDLE_MINUTES=30
AUTH_PASSWORD_TIMEOUT=900

# Booking
BOOKING_PENDING_TIMEOUT_MINUTES=30

# Payments
PAYMENT_DEFAULT_PROVIDER=manual
PAYMENT_CURRENCY=USD
PAYMENT_MANUAL_ENABLED=true
PAYMENT_PAYPAL_ENABLED=false

# PayPal (srmklive/paypal) — required when PAYMENT_PAYPAL_ENABLED=true
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_APP_ID=
PAYPAL_CURRENCY=USD
PAYPAL_PAYMENT_ACTION=Sale
PAYPAL_LOCALE=en_US
PAYPAL_VALIDATE_SSL=true
PAYPAL_NOTIFY_URL="${APP_URL}/webhooks/paypal"
PAYPAL_WEBHOOK_ID=
